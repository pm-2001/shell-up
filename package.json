{
  "name": "@pm-2001/shellup",
  "version": "0.3.1",
  "description": "Level up your terminal in 60 seconds — a beautiful prompt, modern tool swaps, and sane defaults, installed by one command and reversible by another.",
  "keywords": [
    "terminal",
    "zsh",
    "prompt",
    "cli",
    "dotfiles",
    "shell",
    "developer-experience",
    "theme",
    "productivity"
  ],
  "homepage": "https://github.com/pm-2001/shell-up#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pm-2001/shell-up.git"
  },
  "bugs": {
    "url": "https://github.com/pm-2001/shell-up/issues"
  },
  "license": "MIT",
  "author": "pm-2001",
  "type": "module",
  "bin": {
    "shellup": "dist/cli.js"
  },
  "files": [
    "dist",
    "runtime",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "fast-string-width": "^3.0.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
